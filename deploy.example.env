# Local auto-deploy configuration.
# Copy this file to deploy.local.env and fill only the values you need.
# deploy.local.env is ignored by Git so VPS data stays local.

AUTO_DEPLOY_BRANCH=main
AUTO_DEPLOY_REMOTE=origin

# Optional kill switch. Set to 1 to disable the post-commit automation.
AUTO_DEPLOY_DISABLE=0

# VPS deploy is skipped until these values are configured.
# The VPS path must already contain a clone of this repository.
# VPS_SSH_TARGET=deploy@your-vps.example.com
# VPS_APP_DIR=/var/www/jaralingua

# Optional SSH settings.
# VPS_SSH_PORT=22
# VPS_SSH_KEY=C:\Users\USER\.ssh\id_ed25519

# Optional VPS Git remote name and command after the pull/reset.
# VPS_GIT_REMOTE=origin
# VPS_POST_DEPLOY_COMMAND=systemctl reload nginx
