ELEVENLABS_API_KEY=put_your_api_key_here

# Legacy fallback voices. The generator still supports these, but serious
# dialogue work should use the pools and/or per-character voices below.
ELEVENLABS_VOICE_ID=put_primary_fallback_voice_id_here
ELEVENLABS_VOICE_ID_2=put_secondary_fallback_voice_id_here

ELEVENLABS_DIALOGUE_MODEL_ID=eleven_v3
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_MAX_DIALOGUE_CHARS=1900
ELEVENLABS_TEXT_NORMALIZATION=auto

# Professional voice pools. Use US-accent English voices for English and
# France-accent French voices for French. Add as many as your plan allows;
# the ElevenLabs dialogue endpoint supports up to 10 unique voice IDs.
ELEVENLABS_VOICE_POOL_EN_US_FEMALE=put_us_female_voice_id_1_here,put_us_female_voice_id_2_here
ELEVENLABS_VOICE_POOL_EN_US_MALE=put_us_male_voice_id_1_here,put_us_male_voice_id_2_here
ELEVENLABS_VOICE_POOL_EN_US_NEUTRAL=put_us_narrator_voice_id_here
ELEVENLABS_VOICE_POOL_FR_FR_FEMALE=put_france_female_voice_id_1_here,put_france_female_voice_id_2_here
ELEVENLABS_VOICE_POOL_FR_FR_MALE=put_france_male_voice_id_1_here,put_france_male_voice_id_2_here
ELEVENLABS_VOICE_POOL_FR_FR_NEUTRAL=put_france_narrator_voice_id_here

# Optional exact casting by speaker. These override pools.
ELEVENLABS_VOICE_NARRATOR=put_narrator_voice_id_here
ELEVENLABS_VOICE_TEACHER=put_teacher_voice_id_here
ELEVENLABS_VOICE_SARA=put_sara_voice_id_here
ELEVENLABS_VOICE_ALEX=put_alex_voice_id_here
ELEVENLABS_VOICE_ANA=put_ana_voice_id_here
ELEVENLABS_VOICE_DANIEL=put_daniel_voice_id_here
ELEVENLABS_VOICE_VOIX_A=put_france_voice_a_id_here
ELEVENLABS_VOICE_VOIX_B=put_france_voice_b_id_here
