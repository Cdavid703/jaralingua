  {
    "path": "ingles/preintermedio-1/audio/unit3/food-fitness/definition-1.mp3",
    "text": "Food that is changed from its natural form, like packaged snacks.",
    "voice_id": "EXAVITQu4vr4xnSDxMaL",
    "voice": "Sarah (catalog)",
    "model_id": "eleven_multilingual_v2",
    "language_profile": "english-us",
    "seed": 20261108,
    "sha256": "53955956305fdf11c19414962eba972a8a86d9123991b7fc026da7126bcc39a5",
    "scribe": "Food that is changed from its natural form, like packaged snacks",
    "normalized_match": true
  },
  {
    "path": "ingles/preintermedio-1/audio/unit3/food-fitness/definition-2.mp3",
    "text": "Units that show how much energy is in the food we eat.",
    "voice_id": "EXAVITQu4vr4xnSDxMaL",
    "voice": "Sarah (catalog)",
    "model_id": "eleven_multilingual_v2",
    "language_profile": "english-us",
    "seed": 20261108,
    "sha256": "a31fc435f068f795811165ee7c099723bdb905c0af6b8d3c501ec8a5924fefc8",
    "scribe": "Units that show how much energy is in the food we eat.",
    "normalized_match": true
  },
  {
    "path": "ingles/preintermedio-1/audio/unit3/food-fitness/definition-3.mp3",
    "text": "A type of nutrient in foods like bread, rice, and fruits that give us energy.",
    "voice_id": "EXAVITQu4vr4xnSDxMaL",
    "voice": "Sarah (catalog)",
    "model_id": "eleven_multilingual_v2",
    "language_profile": "english-us",
    "seed": 20261108,
    "sha256": "191051ac21a125688c99df793f06c31bf98467e2605ac5d9ec9837946a89e4a9",
    "scribe": "A type of nutrient in foods like bread, rice, and fruits that give us energy.",
    "normalized_match": true
  },
  {
    "path": "ingles/preintermedio-1/audio/unit3/food-fitness/definition-4.mp3",
    "text": "Eating foods from plants, such as fruits, veggies, and nuts, and less meat and dairy.",
    "voice_id": "EXAVITQu4vr4xnSDxMaL",
    "voice": "Sarah (catalog)",
    "model_id": "eleven_multilingual_v2",
    "language_profile": "english-us",
    "seed": 20261108,
    "sha256": "cf3ad5c4324eb82f0bf00ff31e03bc80989fbe7dc8131d27ea65d0a18dea0373",
    "scribe": "Eating foods from plants such as fruits, veggies, and nuts, and less meat and dairy",
    "normalized_match": true
  },
  {
    "path": "ingles/preintermedio-1/audio/unit3/food-fitness/definition-5.mp3",
    "text": "Active activities that make your heart rate and breathing faster, like swimming or running, for better heart health.",
    "voice_id": "EXAVITQu4vr4xnSDxMaL",
    "voice": "Sarah (catalog)",
    "model_id": "eleven_multilingual_v2",
    "language_profile": "english-us",
    "seed": 20261108,
    "sha256": "7dc816b194d669a0e88bf7d1192a42e08b04ef1e07750452c9dc0991170ddbe9",
    "scribe": "Active activities that make your heart rate and breathing faster, like swimming or running, for better heart health.",
    "normalized_match": true
  },
  {
    "path": "ingles/preintermedio-1/audio/unit3/food-fitness/model-a.mp3",
    "text": "She follows a plant-based diet, which means she doesn't eat meat or dairy products.",
    "voice_id": "EXAVITQu4vr4xnSDxMaL",
    "voice": "Sarah (catalog)",
    "model_id": "eleven_multilingual_v2",
    "language_profile": "english-us",
    "seed": 20261108,
    "sha256": "620643c776eacbf198d05b632c0037fe20ac5c56a3f4e3de6fc94e7c7f32adab",
    "scribe": "She follows a plant-based diet, which means she doesn't eat meat or dairy products",
    "normalized_match": true
  },
  {
    "path": "ingles/preintermedio-1/audio/unit3/food-fitness/model-b.mp3",
    "text": "Eating a lot of carbohydrates, like pasta and bread, can give you energy for your daily activities.",
    "voice_id": "EXAVITQu4vr4xnSDxMaL",
    "voice": "Sarah (catalog)",
    "model_id": "eleven_multilingual_v2",
    "language_profile": "english-us",
    "seed": 20261108,
    "sha256": "89af4179404d2638ab81df76679c59171a8b9d50be4b8d7a581b957f6c5d1153",
    "scribe": "Eating a lot of carbohydrates like pasta and bread can give you energy for your daily activities",
    "normalized_match": true
  },
  {
    "path": "ingles/preintermedio-1/audio/unit3/food-fitness/model-c.mp3",
    "text": "The label on this can of soda tells you that it has a lot of calories, so you might want to choose a healthier drink.",
    "voice_id": "EXAVITQu4vr4xnSDxMaL",
    "voice": "Sarah (catalog)",
    "model_id": "eleven_multilingual_v2",
    "language_profile": "english-us",
    "seed": 20261108,
    "sha256": "0812c3fcfb3b4e493bba296d6bb78de7b6c5816dfbaee0e64ccf5dfe43d0b6cc",
    "scribe": "The label on this can of soda tells you that it has a lot of calories, so you might want to choose a healthier drink.",
    "normalized_match": true
  },
  {
    "path": "ingles/preintermedio-1/audio/unit3/food-fitness/model-d.mp3",
    "text": "Doing regular aerobic exercise, like running or swimming, can strengthen your heart and lungs.",
    "voice_id": "EXAVITQu4vr4xnSDxMaL",
    "voice": "Sarah (catalog)",
    "model_id": "eleven_multilingual_v2",
    "language_profile": "english-us",
    "seed": 20261108,
    "sha256": "66b11cee1fe8412d371d80fbf73657c079ad1c7f3050919fe462b283901e72e0",
    "scribe": "Doing regular aerobic exercise like running or swimming can strengthen your heart and lungs.",
    "normalized_match": true
  },
  {
    "path": "ingles/preintermedio-1/audio/unit3/food-fitness/model-e.mp3",
    "text": "Many schools are replacing processed food in their cafeterias with healthier, homemade options.",
