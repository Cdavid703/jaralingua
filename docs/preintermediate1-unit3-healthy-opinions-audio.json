    "generated_on": "2026-11-10",
    "sha256": "dec3bbd88004341eb0b83553ed4d395ee9b2c5ccfc9170d2ed841f592f949630",
    "scribe": "If the government really cared about people's health, they would ban cigarettes and alcohol completely",
    "normalized_match": true,
    "reused": false,
    "verified": true
  },
  {
    "path": "ingles/preintermedio-1/audio/unit3/healthy-opinions/statement-4.mp3",
    "text": "Aerobic exercise is a waste of time. I think that people should only focus on strength training.",
