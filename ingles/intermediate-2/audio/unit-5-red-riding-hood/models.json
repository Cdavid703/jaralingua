  "items": [
    {
      "id": "cd2e503d535279",
      "file": "page-01-cd2e503d535279.mp3",
      "text": "A basket for Grandma. One bright morning, Little Red puts on her red cape. Her mother gives her a basket of bread and honey. \"You look excited,\" her mother says. \"Grandma is feeling under the weather. Take this basket to her, but stay on the path.\" \"I want to cheer her up,\" Little Red says. She waves goodbye and walks towards the forest.",
      "kind": "section",
      "bytes": 335247,
      "sha256": "fee92c6ed1cb0e2356f5820fc8ab33c1b05e7abf8a85a17c16698c09c9d0f9bd"
    },
    {
