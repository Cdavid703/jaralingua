  "items": [
    {
      "file": "section-1.mp3",
      "text": "Have you ever seen this science fiction movie? I've already watched the original, but I haven't seen the sequel yet.",
      "kind": "section",
      "bytes": 99936,
      "sha256": "f3d14c0685aa576a186f613130cbf7fbb9bb23eefe90cd3da0fb73006c20cb4c"
    },
    {
      "file": "section-2.mp3",
      "text": "The plot is gripping because the characters face a difficult choice. Although the ending is predictable, the acting is convincing.",
      "kind": "section",
      "bytes": 122924,
      "sha256": "e0b77e2fb5712f9814fa12c9f88d0552e2fc1b2816f835cc6cbd60b565824192"
    },
    {
      "file": "section-3.mp3",
      "text": "The band has just released a catchy soundtrack. The music brings the characters to life and makes the story memorable.",
      "kind": "section",
      "bytes": 102862,
      "sha256": "ac9b18b1c547bd6b1e74f22d3eb4f4e120f46999bbdc0da436024fe25fb01739"
    },
    {
      "file": "section-4.mp3",
      "text": "If you're looking for a great movie, check it out. It kept me on the edge of my seat.",
      "kind": "section",
      "bytes": 75276,
      "sha256": "97edfa85580fb6db30251239c0db4677c82a9a089cbfce0d59860d6a8a506c69"
    },
    {
      "file": "make-your-movie-review-clear-model-us.mp3",
      "text": "Have you ever seen this science fiction movie? I've already watched the original, but I haven't seen the sequel yet. The plot is gripping because the characters face a difficult choice. Although the ending is predictable, the acting is convincing. The band has just released a catchy soundtrack. The music brings the characters to life and makes the story memorable. If you're looking for a great movie, check it out. It kept me on the edge of my seat.",
      "kind": "section",
      "bytes": 405882,
      "sha256": "ee18a50397b5e060e56c9a559d6a297d32af1526e10650ef84459ee4e3223659"
