    },
    {
      "id": "reported-can",
      "file": "reported-can.mp3",
      "text": "The singer said she could perform on Saturday.",
      "kind": "phrase",
      "bytes": 41004,
      "sha256": "80f7713cb0e8f243f68f22286098cf60f2122bf431a51824ce84aa304197fcf8"
    },
    {
      "id": "still-true",
      "file": "still-true.mp3",
      "text": "The reporter said that the library is still closed.",
      "kind": "phrase",
      "bytes": 47273,
      "sha256": "66e6172f5a73975053a609bc84b55a41bc6f9fa1332628c7d25f96a594b52b2b"
    },
    {
      "id": "source-attribution",
      "file": "source-attribution.mp3",
      "text": "According to the council, the inspection is complete.",
      "kind": "phrase",
      "bytes": 47691,
      "sha256": "b0df14f3dde7641cd20175ce4a0c690ea8d75f7f9902c21fc7b804b24e6ee93c"
    },
    {
      "id": "cautious-reporting",
      "file": "cautious-reporting.mp3",
      "text": "The report has not been confirmed. We do not yet know the cause.",
      "kind": "phrase",
      "bytes": 60648,
      "sha256": "1b8f1585211760f43bc5583785a961d5cba0419b20f502cf714d1d9208ced40f"
    },
    {
      "id": "past-sequence",
