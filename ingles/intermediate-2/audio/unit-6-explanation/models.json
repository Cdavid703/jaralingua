    },
    {
      "id": "reported-will",
      "file": "reported-will.mp3",
      "text": "The spokesperson said they would publish the repair plan the following day.",
      "kind": "phrase",
      "bytes": 64827,
      "sha256": "5f456e48ade35bd785c72a892a93cd20befa8a7f7de1f3e2d0b508ea48a6fe26"
    },
    {
