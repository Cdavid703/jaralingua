    {
      "id": "answer-look-for",
      "file": "answer-look-for.mp3",
      "text": "Before they found Mr Reed, the rescuers looked for the missing neighbour.",
      "kind": "model",
      "bytes": 68588,
      "sha256": "602cc5c43625b302c05383af6bfc19fc78244d71b00be7307c6f9b6ab5c19363"
    },
    {
      "id": "answer-look-at",
      "file": "answer-look-at.mp3",
      "text": "To choose their route, the rescuers looked at a map.",
