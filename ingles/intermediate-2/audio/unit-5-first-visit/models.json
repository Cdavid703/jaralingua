      "textSha256": "eace38a6005f71e3154578b579059e2de2bd532723246b1a130ab3bfa0b9eb08",
      "bytes": 272971,
      "sha256": "283461e91620c1a464e8a2527aed548f0a20182466fda6e63908246b5340aac9"
    },
    {
      "file": "page-17-q1.mp3",
      "text": "Compare this room and Alex's posture with the first page.",
      "kind": "question",
      "textSha256": "4fefd348e8a339b03b575c651d53af71eba544322b24b882c07674f18efbdab6",
      "sha256": "ee5f05ac78b97eedbc5303195f548ac0845d305e3ffd9916a8a1d8fdd369f1e7",
      "bytes": 55214
    },
    {
