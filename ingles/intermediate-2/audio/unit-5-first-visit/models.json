      "sha256": "4760662b967f44aec3bfbb3a400170d3613e907fe2fb9bd4f9afb17be7090c81",
      "bytes": 40586
    },
    {
      "file": "page-14-q5.mp3",
      "text": "What could the family do together before the evening ends?",
      "kind": "question",
      "textSha256": "90d646eda353d58cde96573350f70bc205158187110cacf8447676120eec07c6",
      "sha256": "0ce6fa9b4068ffabd1d61adb8045abda5755829983c69a55fd5023fe7aa45d64",
      "bytes": 49363
    },
    {
      "file": "page-14.mp3",
      "text": "The lights grow dim, and Elena enters with a small cake. It is Rosa's birthday! Alex laughs with relief: Daniel was watching the time for a surprise, not waiting for him to leave. The family gathers around Rosa and begins to sing.",
      "kind": "narration",
      "textSha256": "d4e1bf3d1254db43981885e5d3b79b6d1b1b85dc489c79e0ab6d14104e48ba4b",
      "bytes": 235773,
      "sha256": "5804287ab2421ed99c8e95f95d6419f6d60c0b563602e6a00fdfec5b65cd236f"
    },
    {
