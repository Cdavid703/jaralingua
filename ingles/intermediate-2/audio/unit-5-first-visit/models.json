      "textSha256": "9d374b245f79bc345e3864632a7bb411b3f90f2325edebe63c23409fbe451bcf",
      "sha256": "2a2d60722a999c58e3c7bd7ff4cbd42009b483265db19049b84fca38ee762988",
      "bytes": 27629
    },
    {
      "file": "page-11-q5.mp3",
      "text": "How could Alex help solve this small problem?",
      "kind": "question",
      "textSha256": "1ac55346715a29dc2c2cea7ce0e635f5ac761ed368e015abbb134ca46a3a1df1",
      "sha256": "9ca8f70b4d1f28cc3d0d6bc1eb50da56d78ece1c033b6d03be0451af264b893a",
      "bytes": 46437
    },
    {
      "file": "page-11.mp3",
      "text": "As Alex reaches across the table with the last plate, his sleeve catches a glass. Water spreads across the table. 'I'm so sorry,' he says. Maya brings a towel, and Elena moves the bread. Alex waits anxiously for their reaction.",
      "kind": "narration",
      "textSha256": "a2dad72d6d8d41b9c470621d3988339b1edcac5198f5750b993f3b22fe7af578",
      "bytes": 249147,
      "sha256": "a0c3ab7e8f6c8e8b2a834a3b47e75afa5321d514abaf63f8c6dbddea6db22aae"
    },
    {
