      "bytes": 42675,
      "sha256": "457343ff0f0341388d3aaa112026692a916b3d5914d53bf54f0093e078c4bea2"
    },
    {
      "file": "page-13.mp3",
      "text": "After dinner, Alex meets Maya's grandmother properly. 'Call me Rosa,' she says, showing him an old photograph beside a bicycle. She tells a funny story about getting lost. Across the room, Daniel checks his watch and disappears into the kitchen.",
      "kind": "narration",
