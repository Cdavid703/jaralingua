{
  "version": 1,
  "title": "Past Verbs: Step-by-Step Pronunciation",
  "groups": [
    {
      "id": "t",
      "sound": "/t/",
      "rule": "After the voiceless sounds /p/, /k/, /f/, /s/, /ʃ/, and /tʃ/, pronounce -ed as /t/. Do not add an extra syllable.",
      "tip": "The last SOUND of the base verb matters, not its last letter. For /t/ and /d/, use the /ɪd/ rule instead."
    },
    {
      "id": "d",
      "sound": "/d/",
      "rule": "After a vowel sound or a voiced consonant sound other than /d/, pronounce -ed as /d/. Do not add an extra syllable.",
      "tip": "Voiced sounds use vibration in your throat. Play ends in a vowel sound: played has one syllable."
    },
    {
      "id": "id",
      "sound": "/ɪd/",
      "rule": "When the base verb ends in the sound /t/ or /d/, pronounce -ed as /ɪd/. This adds one extra syllable.",
      "tip": "Want → wanted (one → two syllables). Need → needed (one → two syllables). The ending has a short vowel, not a long “ee”."
    }
  ],
